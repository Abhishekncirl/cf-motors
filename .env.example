# CF Motor Sales - environment variables
# Copy this file to `.env` and fill in the values from your Firebase project.
# The web config below is public by design (it identifies your project); real
# security comes from Firestore/Storage rules and Firebase Auth. Never commit .env.

# --- Firebase web app config (Project settings > General > Your apps) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Site config ---
# Canonical public URL (used for SEO canonical tags, sitemap and JSON-LD).
VITE_SITE_URL=https://www.cfmotorsales.ie
# Base path. '/' for a custom domain; '/repo-name/' for project GitHub Pages.
VITE_BASE_PATH=/
